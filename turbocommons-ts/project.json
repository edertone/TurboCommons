{
  "name": "turbocommons-ts",
  "root": "turbocommons-ts",
  "sourceRoot": "turbocommons-ts/src/main/ts",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "turbocommons-ts" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "npm run test", "cwd": "turbocommons-ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "turbocommons-ts" }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "npm run package", "cwd": "turbocommons-ts" },
      "outputs": ["{projectRoot}/dist/packages"]
    }
  }
}
