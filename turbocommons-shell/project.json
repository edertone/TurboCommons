{
  "name": "turbocommons-shell",
  "root": "turbocommons-shell",
  "sourceRoot": "turbocommons-shell/ubuntu",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "turbocommons-shell" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run test", "cwd": "turbocommons-shell" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "turbocommons-shell" }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run package", "cwd": "turbocommons-shell" }
    }
  }
}
