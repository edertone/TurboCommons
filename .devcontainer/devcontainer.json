{
    "name": "TurboCommons",
    "build": {
        "context": "..",
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/turbocommons,type=bind,consistency=cached",
    "workspaceFolder": "/workspace/turbocommons",
    "mounts": [
        "source=turbocommons-node-modules,target=/opt/turbocommons/node_modules,type=volume",
        "source=turbocommons-ts-node-modules,target=/opt/turbocommons-ts/node_modules,type=volume",
        "source=turbocommons-php-vendor,target=/workspace/turbocommons/packages/turbocommons-php/vendor,type=volume",
        "source=turbocommons-npm-cache,target=/opt/npm-cache,type=volume",
        "source=turbocommons-composer-cache,target=/opt/composer/cache,type=volume",
        "source=turbocommons-gradle-cache,target=/opt/gradle,type=volume"
    ],
    "containerEnv": {
        "TURBOCOMMONS_DEV_CONTAINER": "1"
    },
    "overrideCommand": true,
    "postCreateCommand": "node .devcontainer/workflow.cjs deps"
}