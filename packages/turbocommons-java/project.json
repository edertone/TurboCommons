{
  "name": "turbocommons-java",
  "root": "packages/turbocommons-java",
  "sourceRoot": "packages/turbocommons-java/src/main/java",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash gradlew build", "cwd": "packages/turbocommons-java" },
      "outputs": ["{projectRoot}/build/libs"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bash gradlew test", "cwd": "packages/turbocommons-java" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash gradlew check", "cwd": "packages/turbocommons-java" }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "bash gradlew jar", "cwd": "packages/turbocommons-java" },
      "outputs": ["{projectRoot}/build/libs"]
    }
  }
}
