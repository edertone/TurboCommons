{
  "name": "turbocommons-java",
  "root": "turbocommons-java",
  "sourceRoot": "turbocommons-java/src/main/java",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "./gradlew build", "cwd": "turbocommons-java" },
      "outputs": ["{projectRoot}/build/libs"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "./gradlew test", "cwd": "turbocommons-java" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "./gradlew check", "cwd": "turbocommons-java" }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "./gradlew jar", "cwd": "turbocommons-java" },
      "outputs": ["{projectRoot}/build/libs"]
    }
  }
}
