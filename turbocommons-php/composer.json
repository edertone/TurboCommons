{
	"name" : "turbocommons/turbocommons-php",
	"description" : "General purpose library that implements frequently used and generic software development tasks",
	"type" : "library",
	"license" : "Apache-2.0",
	"minimum-stability" : "stable",
	"autoload" : {
		"classmap" : ["src/main/php/"]
	},
	"autoload-dev" : {
		"classmap" : ["src/test/php/"]
	},
	"require-dev" : {
		"phpunit/phpunit" : "^8.5"
	},
	"scripts" : {
		"build" : "php scripts/build-phar.php",
		"test" : "phpunit --configuration phpunit.xml",
		"lint" : "php scripts/lint.php",
		"package" : "php scripts/build-phar.php"
	},
	"homepage" : "https://turboframework.org/en/libs/turbocommons",
	"keywords" : [
		"general",
		"purpose",
		"development",
		"library"
	],
	"support" : {
		"email" : "edertone.info@gmail.com",
		"source" : "https://github.com/edertone/TurboCommons"
	}
}