{
  "name": "turbocommons-php",
  "root": "turbocommons-php",
  "sourceRoot": "turbocommons-php/src/main/php",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "composer install --no-interaction --no-progress && composer run build", "cwd": "turbocommons-php" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "composer install --no-interaction --no-progress && composer test", "cwd": "turbocommons-php" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "composer install --no-interaction --no-progress && composer lint", "cwd": "turbocommons-php" }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "composer run package", "cwd": "turbocommons-php" },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
